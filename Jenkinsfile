pipeline {
  agent any
  stages {
    stage('compile') {
      steps {
        echo 'compiling the source code'
      }
    }
    stage('test') {
      steps {
        echo 'testing the test cases'
      }
    }
    stage('package') {
      steps {
        echo 'packaging the source code'
      }
    }
  }
}

  
